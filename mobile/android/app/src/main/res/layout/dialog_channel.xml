<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channelDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvChannelHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="📻 [FREQUENCY TUNER]"
            android:textColor="#FFB000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseChannel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="SELECT NATIONWIDE MESH RELAY CHANNEL OR TYPE CUSTOM KEY"
        android:textColor="#7DD3FC"
        android:textSize="10sp" />

    <!-- City Hub Selector Quick Buttons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:text="=== [POPULAR RADIO HUBS] ==="
        android:textColor="#00F0FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHubIndiaMain"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#131D31"
            android:fontFamily="sans-serif"
            android:text="[INDIA]"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHubDelhi"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#131D31"
            android:fontFamily="sans-serif"
            android:text="[DELHI]"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHubMumbai"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#131D31"
            android:fontFamily="sans-serif"
            android:text="[MUMBAI]"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHubBangalore"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#131D31"
            android:fontFamily="sans-serif"
            android:text="[BLR]"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHubChennai"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#131D31"
            android:fontFamily="sans-serif"
            android:text="[CHENNAI]"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHubHyderabad"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#131D31"
            android:fontFamily="sans-serif"
            android:text="[HYD]"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Channel Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:text="=== [CUSTOM PRIVATE FREQUENCY] ==="
        android:textColor="#F59E0B"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCustomChannel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#131D31"
        android:fontFamily="sans-serif"
        android:hint="e.g. TACTICAL-INDIA-1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnJoinChannel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#F59E0B"
        android:fontFamily="sans-serif"
        android:text="[ 📻 LOCK FREQUENCY CHANNEL ]"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
