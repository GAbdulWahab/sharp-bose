<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callHistoryDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="📋 [COMMUNICATION CDR LOGS]"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#1E293B"
            android:fontFamily="monospace"
            android:text="[CLEAR]"
            android:textColor="#EF4444"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="PERSISTENT CALL RECORDS • INCOMING / OUTGOING / MISSED MATRIX"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <!-- History List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#070A13"
        android:maxHeight="360dp"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/llCallHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty state -->
            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="24dp"
                android:text=">>> NO CDR LOGS RECORDED &lt;&lt;&lt;\nMake or receive calls to populate matrix."
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
