<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#05080F"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Status Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#064E3B"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text=">>> [INCOMING TACTICAL CALL] &lt;&lt;&lt;"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Avatar Circle -->
        <TextView
            android:id="@+id/tvIncomingAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#00FF66"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="[TX]"
            android:textColor="#05080F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Caller Name -->
        <TextView
            android:id="@+id/tvIncomingCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="[NODE: LAPTOP WEB]"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Route and Encryption Meta -->
        <TextView
            android:id="@+id/tvIncomingRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="ROUTE: [DIRECT BLE L2CAP // 0 HOPS]"
            android:textColor="#00FF66"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="CIPHER: [NOISE_XX 256-BIT // 16kHz PCM]"
            android:textColor="#7DD3FC"
            android:textSize="10sp" />

        <!-- Action Buttons: Decline and Accept -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDeclineCall"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#DC2626"
                android:fontFamily="monospace"
                android:text="[ ✕ DECLINE ]"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAcceptCall"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#059669"
                android:fontFamily="monospace"
                android:text="[ 📞 ACCEPT ]"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
