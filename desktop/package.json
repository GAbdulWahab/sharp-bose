{
  "name": "sharp-bose-desktop",
  "version": "2.0.0",
  "description": "Standalone Offline Desktop Tactical Mesh Terminal & Hub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:low-ram": "electron . --js-flags=\"--max-old-space-size=64 --lite-mode\" --disable-gpu",
    "start:webview": "launch-app-webview.bat",
    "serve": "node main.js --headless",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable -c.win.signAndEditExecutable=false -c.forceCodeSigning=false",
    "dist:portable": "electron-builder --win portable -c.win.signAndEditExecutable=false -c.forceCodeSigning=false",
    "dist:installer": "electron-builder --win nsis -c.win.signAndEditExecutable=false -c.forceCodeSigning=false"
  },
  "build": {
    "appId": "com.sharpbose.desktop",
    "productName": "SharpBoseTacticalMesh",
    "forceCodeSigning": false,
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "styles.css",
      "package.json",
      "node_modules/ws/**",
      "!dist/**",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "differentialPackage": false
    },
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "mesh",
    "offline-calling",
    "tactical-radio",
    "p2p",
    "e2ee"
  ],
  "author": "Sharp-Bose Team",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
